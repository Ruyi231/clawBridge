{
  "name": "clawbridge",
  "version": "2.4.1",
  "private": true,
  "description": "A local Feishu-to-Codex bridge for Windows.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor:projects": "node scripts/verify-project-paths.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "better-sqlite3": "12.2.0",
    "pino": "9.9.0",
    "yaml": "^2.9.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
